# The list has to cover everything the shell and `tether-dev-compose` are
# evaluated from, or direnv keeps a stale shell on the path.
watch_file flake.nix flake.lock rust-toolchain.toml Cargo.toml Cargo.lock
watch_file nix/*.nix nix/dev/*.nix nix/dev/services/*.nix
watch_file crates/*/package.nix crates/*/Cargo.toml
use flake

source_env_if_exists .local.envrc
