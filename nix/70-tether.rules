# Lets the logged-in user open the iPhones tetherd takes (`PHONES` in
# crates/ios/src/usb.rs). systemd does the same for adb devices by itself.
# The file has to sort before 73-seat-late.rules, which applies uaccess.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="12[9a][0-9a-f]", TAG+="uaccess"
