{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"paths": {
			"#generated/*": ["./generated/*"]
		}
	},
	"files": ["rspack.config.ts", "playwright.config.ts"]
}
